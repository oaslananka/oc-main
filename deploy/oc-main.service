[Unit]
Description=oc-main GitHub webhook control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ocmain
Group=ocmain
WorkingDirectory=/opt/oc-main
EnvironmentFile=/etc/oc-main.env
ExecStart=/usr/bin/node /opt/oc-main/src/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/oc-main
StateDirectory=oc-main
UMask=0077

[Install]
WantedBy=multi-user.target
