webhook.oaslananka.dev {
	encode zstd gzip

	@oaslananka_ops path /oaslananka-ops
	handle @oaslananka_ops {
		header {
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			X-Frame-Options "DENY"
			-Server
		}
		reverse_proxy oc-main-webhook:8787
	}

	handle {
		respond 404
	}

	log {
		output stdout
		format json
	}
}
