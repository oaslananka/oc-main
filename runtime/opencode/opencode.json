{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "default_agent": "orchestrator",
  "formatter": false,
  "lsp": true,
  "tool_output": {
    "max_lines": 1200,
    "max_bytes": 120000
  },
  "permission": {
    "external_directory": "deny",
    "question": "deny",
    "skill": {
      "*": "deny",
      "oc-*": "allow"
    },
    "bash": {
      "*": "allow",
      "*git push*": "deny",
      "*git commit*": "deny",
      "*git remote*": "deny",
      "gh *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "rsync *": "deny"
    },
    "task": "deny"
  },
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "scout": {
      "disable": true
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    }
  }
}
