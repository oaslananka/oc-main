{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "update": "disable",
  "default_agent": "orchestrator",
  "formatter": false,
  "lsp": true,
  "tool_output": {
    "max_lines": 1200,
    "max_bytes": 120000
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "oc-*",
      "effect": "allow"
    },
    {
      "action": "bash",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "bash",
      "resource": "*git push*",
      "effect": "deny"
    },
    {
      "action": "bash",
      "resource": "*git commit*",
      "effect": "deny"
    },
    {
      "action": "bash",
      "resource": "*git remote*",
      "effect": "deny"
    },
    {
      "action": "bash",
      "resource": "gh *",
      "effect": "deny"
    },
    {
      "action": "bash",
      "resource": "ssh *",
      "effect": "deny"
    },
    {
      "action": "bash",
      "resource": "scp *",
      "effect": "deny"
    },
    {
      "action": "bash",
      "resource": "rsync *",
      "effect": "deny"
    },
    {
      "action": "task",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "scout": {
      "disabled": true
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "disabled": false,
        "protocol": "legacy"
      }
    }
  }
}
